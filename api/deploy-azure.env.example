# Copy to deploy-azure.env and fill in. Never commit deploy-azure.env.
# Wrap values that contain spaces or semicolons in single quotes.

AZURE_RESOURCE_GROUP=DevTest
AZURE_LOCATION=uksouth
AZURE_ACR_NAME=juskeldevacr
AZURE_CONTAINERAPPS_ENV=juskel-dev-env
AZURE_CONTAINER_APP=juskel-api
AZURE_LOG_ANALYTICS=juskel-dev-logs

# Development = Swagger on. Use Production only for real prod deploys.
ASPNETCORE_ENVIRONMENT=Development

# Required secrets (use your Azure SQL connection string)
CONNECTIONSTRINGS__IDENTITY='Server=tcp:devtestjuskel01.database.windows.net,1433;Database=free-sql-db-0501288;User ID=devprovision;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;'

# Min 32 chars
JWT__SECRET='YOUR_PRODUCTION_JWT_SECRET_MIN_32_CHARS'

# Min 32 chars — AES-256-GCM key for email, first name, last name at rest
ENCRYPTION__FIELDKEY='YOUR_FIELD_ENCRYPTION_KEY_MIN_32_CHARS'

# Min 32 chars — HMAC key for email lookup hashes (identity PII)
ENCRYPTION__EMAILLOOKUPKEY='YOUR_EMAIL_LOOKUP_KEY_MIN_32_CHARS'

EMAIL__PROVIDER=Resend
EMAIL__DEFAULTFROM='juskel <hello@juskel.co.uk>'
EMAIL__RESEND__APIKEY='re_YOUR_RESEND_KEY'
EMAIL__ASSETSBASEURL=https://cdn.juskel.com/email

# Known FQDN (for first deploy OAuth redirect URIs). Update if the app URL changes.
AZURE_API_BASE_URL=https://juskel-api.livelydune-575d8971.uksouth.azurecontainerapps.io

# Companies House — same live API key as sandbox/companies-house/secrets.env (no new key type).
# Azure Container Apps use dynamic outbound IPs; do NOT IP-restrict this key for server-side Azure use.
INTEGRATIONS__COMPANIESHOUSE__APIKEY='your-companies-house-api-key'
INTEGRATIONS__COMPANIESHOUSE__BASEURL=https://api.company-information.service.gov.uk

# Optional: module-specific SQL strings (default to CONNECTIONSTRINGS__IDENTITY if omitted)
# CONNECTIONSTRINGS__ONBOARDING='...'
# CONNECTIONSTRINGS__FUNDING='...'
# CONNECTIONSTRINGS__SCORING='...'

# Evidence file uploads (required on Azure — local disk is ephemeral)
AZURE_STORAGE_ACCOUNT=juskeldevstore
INTEGRATIONS__BLOBSTORAGE__PROVIDER=Azure
INTEGRATIONS__BLOBSTORAGE__AZURECONTAINERNAME=evidence
# Optional — auto-resolved from AZURE_STORAGE_ACCOUNT during deploy if omitted:
# INTEGRATIONS__BLOBSTORAGE__AZURECONNECTIONSTRING='DefaultEndpointsProtocol=https;AccountName=...'

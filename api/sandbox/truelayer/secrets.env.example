# Copy to secrets.env — never commit
# TrueLayer Console → sandbox app → client_id + client_secret

TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=

TRUELAYER_API_BASE_URL=https://api.truelayer-sandbox.com

# Whitelist this exact URL in TrueLayer Console → App → Redirect URIs
TRUELAYER_REDIRECT_URI=http://127.0.0.1:8767/callback

# Alternative (TrueLayer-hosted code display page):
# TRUELAYER_REDIRECT_URI=https://console.truelayer-sandbox.com/redirect-page

# Space-separated scopes — enable matching permissions in Console
TRUELAYER_SCOPES="info accounts balance transactions offline_access"

# Mock Bank provider for sandbox auth link
TRUELAYER_SANDBOX_PROVIDER=uk-cs-mock
TRUELAYER_MOCK_USERNAME=john
TRUELAYER_MOCK_PASSWORD=doe

# After ./test.sh exchange — or UI saves automatically
TRUELAYER_ACCESS_TOKEN=
TRUELAYER_REFRESH_TOKEN=

# Paste code from redirect page for ./test.sh exchange
TRUELAYER_AUTH_CODE=

TRUELAYER_TRANSACTIONS_DAYS=90

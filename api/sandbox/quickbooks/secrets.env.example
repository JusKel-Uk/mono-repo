# Copy to secrets.env and fill in — never commit secrets.env

# --- From Intuit Developer Portal → your app → Keys & OAuth (Development / Sandbox) ---
QUICKBOOKS_CLIENT_ID=your-sandbox-client-id
QUICKBOOKS_CLIENT_SECRET=your-sandbox-client-secret

# --- From OAuth 2.0 Playground after authorizing a SANDBOX company ---
# https://developer.intuit.com/app/developer/qbo/docs/develop/authentication-and-authorization/oauth-2.0-playground
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ACCESS_TOKEN=
QUICKBOOKS_REFRESH_TOKEN=

# Local explorer UI (api/sandbox/quickbooks/ui) — whitelist this in Intuit Keys & OAuth
QUICKBOOKS_REDIRECT_URI=http://127.0.0.1:8769/callback

# Sandbox API host (do not use quickbooks.api.intuit.com until production go-live)
QUICKBOOKS_API_BASE_URL=https://sandbox-quickbooks.api.intuit.com/v3/company

# Optional
QUICKBOOKS_MINOR_VERSION=65
QUICKBOOKS_REPORT_START_DATE=2026-01-01
QUICKBOOKS_REPORT_END_DATE=2026-12-31

# Copy to secrets.env — never commit
# Yapily Console → Application ID + Secret

YAPILY_APPLICATION_ID=
YAPILY_APPLICATION_SECRET=

YAPILY_API_BASE_URL=https://api.yapily.com

# Register modelo-sandbox in Console with preconfigured credentials first
YAPILY_INSTITUTION_ID=modelo-sandbox
YAPILY_APPLICATION_USER_ID=juskel-sandbox-user

# Must be allowed in Yapily Console for your app (UI default below)
YAPILY_CALLBACK_URL=http://127.0.0.1:8768/callback

# After connect flow — UI callback saves automatically
YAPILY_CONSENT_TOKEN=

YAPILY_SANDBOX_USERNAME=mits
YAPILY_SANDBOX_PASSWORD=mits

YAPILY_TRANSACTIONS_DAYS=90

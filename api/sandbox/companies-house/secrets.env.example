# Copy to secrets.env and fill in — never commit secrets.env

COMPANIES_HOUSE_API_KEY=your-api-key-here

COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk

# Sandbox — company search/autocomplete often returns no results; use LIVE URL above for name search.
# COMPANIES_HOUSE_BASE_URL=https://api-sandbox.company-information.service.gov.uk

# Optional defaults for test.sh
COMPANIES_HOUSE_TEST_COMPANY_NUMBER=00000006

# Copy to secrets.env — never commit

# Provider sandbox (e.g. TrueLayer, your bank's OB sandbox)
OPEN_BANKING_BASE_URL=https://sandbox.openbanking.example
OPEN_BANKING_TOKEN_URL=https://sandbox.openbanking.example/oauth/token

OPEN_BANKING_CLIENT_ID=your-client-id
OPEN_BANKING_CLIENT_SECRET=your-client-secret

# Optional — paste after ./test.sh token or manual OAuth
OPEN_BANKING_ACCESS_TOKEN=

# Some sandboxes require a financial-id header
OPEN_BANKING_FINANCIAL_ID=

# Copy to secrets.env — never commit
# Open Banking via Plaid (sandbox aggregator)

# --- Plaid Dashboard → Team Settings → Keys (Sandbox) ---
PLAID_CLIENT_ID=
PLAID_SECRET=

PLAID_API_BASE_URL=https://sandbox.plaid.com
PLAID_COUNTRY_CODES=GB
PLAID_PRODUCTS=transactions,auth

# UK sandbox institution (Flexible Platypus Open Banking) — see Plaid sandbox institutions docs
PLAID_SANDBOX_INSTITUTION_ID=ins_116834

# After ./test.sh setup — paste access_token here
PLAID_ACCESS_TOKEN=

# Optional: skip setup if you already have a public token from Link
PLAID_PUBLIC_TOKEN=

# transactions/get window (days)
PLAID_TRANSACTIONS_DAYS=90

# Sandbox login for public_token/create (default user_good / pass_good)
PLAID_SANDBOX_USERNAME=user_good
PLAID_SANDBOX_PASSWORD=pass_good

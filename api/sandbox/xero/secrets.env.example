# Copy to secrets.env — never commit

# --- Xero Developer Portal → My Apps → your app (OAuth 2.0) ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# --- From Xero OAuth playground or authorization code flow ---
# https://developer.xero.com/documentation/guides/oauth2/auth-flow
XERO_ACCESS_TOKEN=
XERO_REFRESH_TOKEN=
XERO_TENANT_ID=

XERO_API_BASE_URL=https://api.xero.com/api.xro/2.0

# Report date range (Profit & Loss)
XERO_REPORT_FROM_DATE=2024-01-01
XERO_REPORT_TO_DATE=2024-12-31
XERO_BALANCE_SHEET_DATE=2024-12-31
